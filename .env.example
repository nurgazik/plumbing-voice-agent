# Copy to .env and fill in. .env is gitignored. Never commit values.

# Anthropic (used by n8n and the evals; Retell bills its built-in Haiku itself, no BYOK)
ANTHROPIC_API_KEY=

# Retell
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_LLM_ID=

# Twilio (Canadian number, SMS + MMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# n8n Cloud
N8N_WEBHOOK_BASE_URL=
N8N_MCP_URL=                 # Settings > Instance-level MCP; lets Claude build workflows on the trial plan
N8N_MCP_TOKEN=
N8N_WEBHOOK_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=          # personal access token; lets push scripts run migrations via the management API
SUPABASE_ANON_KEY=

# Cal.com
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# HubSpot
HUBSPOT_PRIVATE_APP_TOKEN=

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# On-call plumber (escalation SMS target). Fictional for the demo.
ONCALL_PHONE_NUMBER=
